From bf7ac443e2c4fb18fb3d27f493445e9730c6422a Mon Sep 17 00:00:00 2001
From: Toby Flynn <tflynn@redwiretechnology.com>
Date: Tue, 30 Sep 2025 10:52:56 -0400
Subject: [PATCH] fix for builidng with older build

---
 PKG-INFO       | 1 -
 pyproject.toml | 5 +----
 2 files changed, 1 insertion(+), 5 deletions(-)

diff --git a/PKG-INFO b/PKG-INFO
index c3097e9..490ef4d 100644
--- a/PKG-INFO
+++ b/PKG-INFO
@@ -19,7 +19,6 @@ Classifier: Programming Language :: Python :: 3.10
 Classifier: Programming Language :: Python :: 3.11
 Classifier: Programming Language :: Python :: 3.12
 Classifier: Programming Language :: Python :: 3.13
-Classifier: Programming Language :: Python :: 3.14
 Classifier: Programming Language :: Python :: Implementation :: CPython
 Classifier: Topic :: Software Development :: Libraries :: Python Modules
 Classifier: Typing :: Typed
diff --git a/pyproject.toml b/pyproject.toml
index 34908a7..a8168b0 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,12 +1,10 @@
 [build-system]
-requires = ['hatchling>=1.27.0']
+requires = ['hatchling']
 build-backend = 'hatchling.build'
 
 [project]
 name = 'typing-inspection'
 version = '0.4.1'
-license = "MIT"
-license-files = ['LICENSE']
 description = 'Runtime typing introspection tools'
 authors = [
     {name = 'Victorien Plot', email = 'contact@vctrn.dev'},
@@ -23,7 +21,6 @@ classifiers = [
     'Programming Language :: Python :: 3.11',
     'Programming Language :: Python :: 3.12',
     'Programming Language :: Python :: 3.13',
-    'Programming Language :: Python :: 3.14',
     'Typing :: Typed',
     'Intended Audience :: Developers',
     'Topic :: Software Development :: Libraries :: Python Modules',
